# Insurance Broker Platform - Environment Variables Template
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=insurance_broker
DB_USER=insurance_admin
DB_PASSWORD=secure_password_change_in_production
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5
DB_CONNECTION_LIFETIME=5m

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_PORT=8096
SERVER_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:7100,http://localhost:4200

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET=your_jwt_secret_key_min_32_chars_change_in_production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# =============================================================================
# AI SERVICES (OpenAI / Anthropic Claude)
# =============================================================================
# Get your API keys from:
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/settings/keys
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# =============================================================================
# SMS SERVICE (Africa's Talking - Kenya)
# =============================================================================
# Sign up at: https://africastalking.com
SMS_API_KEY=your-africastalking-api-key
SMS_USERNAME=your-africastalking-username
SMS_SENDER_ID=InsuranceAI

# =============================================================================
# M-PESA PAYMENT GATEWAY (Safaricom Kenya)
# =============================================================================
# Get credentials from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_PASSKEY=your-mpesa-passkey
MPESA_SHORTCODE=174379

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# =============================================================================
# EMAIL CONFIGURATION (SendGrid)
# =============================================================================
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=your-email-provider-api-key
EMAIL_FROM_ADDRESS=no-reply@insurance.local
EMAIL_FROM_NAME=Insurance Broker AI
